DATABASE_URL=postgres://watchdog:watchdog@localhost:5436/watchdog

# Grok (primary). xAI API is OpenAI-compatible.
XAI_API_KEY=
XAI_MODEL=grok-4.3
LLM_BASE_URL=https://api.x.ai/v1

# Fallback if XAI_API_KEY is empty
OPENAI_API_KEY=

# Demo store base URL the worker drives
DEMO_STORE_URL=http://localhost:3000/store

# Stripe test mode only. Never live keys.
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# Auth
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Read token for /api/bench/hits
BENCH_TOKEN=

# Used when XAI_API_KEY is empty
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Daily audit cap per user (POST /api/runs and rerun)
AUDITS_PER_USER_PER_DAY=5

# Vercel Blob for worker screenshots; empty = write to apps/web/public/screenshots
BLOB_READ_WRITE_TOKEN=
