{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "tsx --env-file=../../.env src/index.ts",
    "run:once": "tsx --env-file=../../.env src/cli.ts",
    "typecheck": "tsc --noEmit",
    "profile:store": "tsx --env-file=../../.env src/profile-cli.ts",
    "sessions:store": "tsx --env-file=../../.env src/sessions-cli.ts",
    "replay:store": "tsx --env-file=../../.env src/replay-cli.ts",
    "bench:run": "tsx --env-file=../../.env src/bench/run.ts",
    "bench:score": "tsx src/bench/score.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "@watchdog/db": "workspace:*",
    "@watchdog/shared": "workspace:*",
    "cheerio": "^1.0.0",
    "is-antibot": "^2.5.17",
    "openai": "^4.80.0",
    "pg-boss": "^10.1.5",
    "playwright": "^1.50.0",
    "robots-parser": "^3.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
